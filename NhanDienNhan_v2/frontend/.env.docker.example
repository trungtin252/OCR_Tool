# Public backend URL included in the production frontend bundle.
VITE_BACKEND_URL=https://ocr.o2n.ai.vn
# Required when the frontend image is built. Use a distinct, strong password
# in the server-only .env.docker file; do not commit that file.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=replace-with-a-strong-password
# Bound only to 127.0.0.1 for the cloudflared system service; never public.
OCR_TUNNEL_ORIGIN_PORT=3002
