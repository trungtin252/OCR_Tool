GEMINI_API_KEY=your_gemini_api_key_here
PORT=5000
# Comma-separated allowlist. Leave empty to preserve allow-all CORS behavior.
CORS_ORIGINS=
# Set to false in production to disable /test-openai and /api/image/test.
ENABLE_TEST_ENDPOINTS=true
# Timeout for each LLM SDK request in milliseconds.
LLM_TIMEOUT_MS=60000
# TTL for in-memory government-search cache in milliseconds (24 hours).
SEARCH_CACHE_TTL_MS=86400000
# Maximum number of distinct government-search results retained in memory.
SEARCH_CACHE_MAX_ENTRIES=200
# Per-request timeout for government-search HTTP requests in milliseconds.
SEARCH_HTTP_TIMEOUT_MS=8000
# Number of retries after the first government-search HTTP request (0-10).
SEARCH_HTTP_MAX_RETRIES=2
# Maximum simultaneous government-search HTTP requests (1-10).
SEARCH_HTTP_CONCURRENCY=2
# Persist every valid Product, Receipt and GA certificate OCR interaction.
OCR_ARCHIVE_ENABLED=true
# Docker path mounted from the host; use an absolute local path outside Docker.
OCR_ARCHIVE_DIR=/app/data/ocr-history
# Stop starting new archives when less than 1 GiB would remain. OCR still runs.
OCR_ARCHIVE_MIN_FREE_BYTES=1073741824
